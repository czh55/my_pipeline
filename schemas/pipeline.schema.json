{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://czh55.github.io/my_pipeline/schemas/pipeline.schema.json",
  "title": "LifePipeline",
  "type": "object",
  "required": ["id", "title", "domain", "intent", "steps", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "domain": {
      "type": "string",
      "enum": ["meta", "life", "work", "learn", "create", "communicate"]
    },
    "intent": {
      "type": "string",
      "description": "核心价值：这条章程要把什么经历变成可复制结果"
    },
    "principle": {
      "type": "string",
      "description": "一句话心法，可选；默认可对应「开门→放入→关门」"
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "description": "山底快速上手：可跟做的有序步骤",
      "items": {
        "type": "object",
        "required": ["name", "detail"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "summit": {
      "type": "string",
      "description": "山顶深度体悟：实践够了才写得清的手感与判断（可空待填）"
    },
    "practice": {
      "type": "array",
      "description": "实践踩坑记录，按时间追加",
      "items": {
        "type": "object",
        "required": ["date", "note"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "when_to_use": { "type": "string" },
    "boundaries": {
      "type": "string",
      "description": "什么时候不该硬套本流程"
    },
    "source": {
      "type": "string",
      "description": "经验来源说明：场景、日期、人或项目；拿来主义时写出处"
    },
    "origin": {
      "type": "string",
      "enum": ["self", "borrowed"],
      "description": "自己定义（self）或拿来主义（borrowed）"
    },
    "status": {
      "type": "string",
      "enum": ["seed", "draft", "validated", "snowball"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "updated": {
      "type": "string",
      "description": "ISO 日期 YYYY-MM-DD"
    }
  }
}
